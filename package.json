{
  "name": "vibemusic",
  "private": true,
  "workspaces": [
    "landing"
  ],
  "version": "1.1.6",
  "type": "module",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "justCallMeJeg",
      "email": "gjpgabayeron@gmail.com"
    },
    {
      "name": "ItsMikhaeli",
      "email": "j.josephmikhaeli@gmail.com"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:landing": "npm run dev -w landing",
    "build:landing": "npm run build -w landing",
    "lint": "eslint src/ && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint src/ --fix && stylelint \"src/**/*.css\" --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "husky && husky install",
    "version:bump": "node scripts/bump-version.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "changelog:preview": "npx --yes git-cliff --unreleased --strip header",
    "changelog:full": "npx --yes git-cliff --offline --output CHANGELOG.md",
    "cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/cleanup.ps1",
    "wizard": "powershell -ExecutionPolicy Bypass -File ./scripts/git-wizard.ps1",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/instrument-sans": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "~2.9.0",
    "@tauri-apps/plugin-dialog": "~2.5.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.5.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.2",
    "@tauri-apps/plugin-updater": "~2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.6",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "~2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "husky": "^8.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
